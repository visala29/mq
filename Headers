if %ERRORLEVEL% EQU 0 (
    REM Create a new message file with headers in XML format
    (
        echo ^<?xml version="1.0" encoding="UTF-8" standalone="yes"?^>
        echo ^<MessageDetails^>
        echo   ^<HeaderInformation^>
        echo     ^<QueueManager^>%QUEUE_MANAGER%^</QueueManager^>
        echo     ^<QueueName^>%QUEUE_NAME%^</QueueName^>
        echo     ^<Date^>%DATE%^</Date^>
        echo     ^<Time^>%TIME%^</Time^>
        echo     ^<MessageNumber^>%MSG_COUNTER%^</MessageNumber^>
        echo   ^</HeaderInformation^>
        echo   ^<MessageContent^>
        type "%SAVE_PATH%\temp_msg.xml"
        echo   ^</MessageContent^>
        echo ^</MessageDetails^>
    ) > "%SAVE_PATH%\%QUEUE_NAME%_msg%MSG_COUNTER%.xml"
